page {
  background: #FFFFFF;
}

.article {
  padding: 32rpx 32rpx 0;
}

.article__title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}

.article__meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-bottom: 28rpx;
  border-bottom: 1px solid var(--line);
}

.article__date {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.article__lead {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid var(--primary);
  background: #F7F9FC;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.article__body {
  padding-top: 8rpx;
}

.article__h {
  display: block;
  margin-top: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.article__p {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.85;
  color: #444444;
  text-align: justify;
}

.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1px solid var(--line);
}

.bar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
}

.bar__star {
  font-size: 36rpx;
  margin-right: 8rpx;
  color: var(--text-3);
}

.bar__star--on {
  color: #FF9A1F;
}

.bar__share {
  margin: 0 !important;
  padding: 0 !important;
  width: auto !important;
  height: 100rpx;
  line-height: 100rpx;
  background: transparent;
  border-radius: 0;
  font-weight: 400;
}

.bar__share-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

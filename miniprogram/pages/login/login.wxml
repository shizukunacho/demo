<view class="page">
  <view class="head">
    <image class="head__logo" src="/image/ui/logo.png" />
    <text class="head__title">手机号登录</text>
  </view>

  <view class="form">
    <view class="cell">
      <text class="form__label">手机号</text>
      <input class="form__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="form__ph" bindinput="onPhoneInput" value="{{phone}}" />
    </view>
    <view class="cell">
      <text class="form__label">密码</text>
      <input class="form__input" password="{{!showPassword}}" placeholder="请输入密码" placeholder-class="form__ph" bindinput="onPasswordInput" value="{{password}}" />
      <image class="form__eye" bindtap="togglePassword" src="{{showPassword ? '/image/eye.png' : '/image/eye_close.png'}}" />
    </view>
  </view>

  <view class="submit">
    <button class="btn {{phone && password ? 'btn-primary' : 'btn-disabled'}}" hover-class="btn-hover" bindtap="handleLogin" loading="{{loading}}">登录</button>
  </view>

  <view class="links">
    <text bindtap="goToForget">忘记密码</text>
    <view class="links__line"></view>
    <text bindtap="goToRegister">注册账号</text>
  </view>
</view>

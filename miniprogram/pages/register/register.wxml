<view class="page">
  <view class="head">
    <image class="head__logo" src="/image/ui/logo.png" />
    <text class="head__title">注册账号</text>
  </view>

  <view class="form">
    <view class="cell">
      <text class="form__label">手机号</text>
      <input class="form__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="form__ph" bindinput="onUsernameInput" value="{{phone}}" />
    </view>
    <view class="cell">
      <text class="form__label">设置密码</text>
      <input class="form__input" password="{{!showPassword}}" placeholder="6-20位字母或数字" placeholder-class="form__ph" bindinput="onPasswordInput" value="{{password}}" />
      <image class="form__eye" bindtap="togglePassword" src="{{showPassword ? '/image/eye.png' : '/image/eye_close.png'}}" />
    </view>
    <view class="cell">
      <text class="form__label">确认密码</text>
      <input class="form__input" password="{{!showConfirmPassword}}" placeholder="请再次输入密码" placeholder-class="form__ph" bindinput="onConfirmPasswordInput" value="{{confirmPassword}}" />
      <image class="form__eye" bindtap="toggleConfirmPassword" src="{{showConfirmPassword ? '/image/eye.png' : '/image/eye_close.png'}}" />
    </view>
  </view>
  <text class="form__tip" wx:if="{{confirmPassword && password !== confirmPassword}}">两次输入的密码不一致</text>

  <view class="submit">
    <button class="btn {{phone && password && confirmPassword ? 'btn-primary' : 'btn-disabled'}}" hover-class="btn-hover" bindtap="handleRegister" loading="{{loading}}">注册</button>
  </view>

  <view class="links">
    <text>已有账号？</text>
    <text class="links__go" bindtap="goToLogin">去登录</text>
  </view>
</view>

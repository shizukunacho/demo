.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  margin-bottom: 24rpx;
  background: #FFF8EC;
  font-size: 24rpx;
  color: #B26B00;
}

.topbar__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  border: 2rpx dashed #C9D3E3;
  border-radius: 16rpx;
  background: #F8FAFD;
}

.uploader--hover {
  background: #EEF3FB;
}

.uploader__plus {
  width: 88rpx;
  height: 88rpx;
}

.uploader__text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-2);
}

.uploader__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.preview {
  position: relative;
  height: 440rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #111111;
}

.preview__img {
  width: 100%;
  height: 100%;
}

.preview__del {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 36rpx;
}

.scanning {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
}

.scanning__line {
  position: absolute;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(47, 123, 245, 0) 0%, rgba(47, 123, 245, 0.4) 90%, #5C9BFF 100%);
  animation: scan 1.6s linear infinite;
}

@keyframes scan {
  0% { transform: translateY(-100rpx); }
  100% { transform: translateY(440rpx); }
}

.scanning__text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FFFFFF;
}

.reselect {
  padding-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}

.req {
  display: flex;
  flex-wrap: wrap;
}

.req__item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--text);
}

.req__ok {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--normal);
  color: #FFFFFF;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.tip-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

<view class="page">
  <view class="top" style="padding-top: {{navTotal + 40}}px;">
    <image class="logo" src="/image/ui/logo.png" />
    <text class="name">乳腺超声智能辅助诊断</text>
    <text class="slogan">AI 辅助 · 快速检测 · 早筛早诊</text>
  </view>

  <view class="intro">
    <view class="intro__item">
      <image class="intro__icon" src="/image/ui/grid-scan.png" />
      <text class="intro__name">图像上传</text>
      <text class="intro__desc">拍照或相册选择</text>
    </view>
    <view class="intro__item">
      <image class="intro__icon" src="/image/ui/grid-guide.png" />
      <text class="intro__name">智能分类</text>
      <text class="intro__desc">正常 / 良性 / 恶性</text>
    </view>
    <view class="intro__item">
      <image class="intro__icon" src="/image/ui/grid-book.png" />
      <text class="intro__name">病灶分割</text>
      <text class="intro__desc">标注病灶区域</text>
    </view>
  </view>

  <view class="actions safe-bottom">
    <button class="btn btn-wechat" hover-class="btn-hover" bindtap="goToWechatLogin">微信一键登录</button>
    <button class="btn btn-default actions__phone" hover-class="btn-hover" bindtap="goToPhoneLogin">手机号登录</button>
    <view class="agree" bindtap="toggleAgree">
      <view class="agree__box {{agreed ? 'agree__box--on' : ''}}"></view>
      <text class="agree__text">我已阅读并同意<text class="agree__link" catchtap="showAgreement">《用户服务协议》</text>和<text class="agree__link" catchtap="showAgreement">《隐私政策》</text></text>
    </view>
  </view>
</view>

<view class="page">
  <view class="block-title">问题类型</view>
  <view class="card types">
    <view class="types__item {{category === item ? 'types__item--on' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onCategory" data-value="{{item}}">{{item}}</view>
  </view>

  <view class="block-title">问题描述</view>
  <view class="card">
    <textarea class="area" maxlength="500" placeholder="请详细描述您遇到的问题或建议（至少 5 个字）" placeholder-class="ph" bindinput="onContent" value="{{content}}" />
    <text class="count">{{content.length}}/500</text>
  </view>

  <view class="block-title">联系方式（选填）</view>
  <view class="card contact">
    <input class="contact__input" maxlength="100" placeholder="手机号 / 微信号 / 邮箱" placeholder-class="ph" bindinput="onContact" value="{{contact}}" />
  </view>

  <view class="submit safe-bottom">
    <button class="btn {{content.length >= 5 ? 'btn-primary' : 'btn-disabled'}}" hover-class="btn-hover" bindtap="submit" loading="{{submitting}}">提交</button>
  </view>
</view>

.page {
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.summary {
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.summary__tip {
  color: var(--text-3);
}

.item {
  margin: 0 24rpx 20rpx;
  padding: 0 28rpx;
  background: var(--white);
  border-radius: 16rpx;
}

.item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  border-bottom: 1px solid var(--line);
}

.item__time {
  font-size: 24rpx;
  color: var(--text-3);
}

.item__body {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.item__main {
  flex: 1;
}

.item__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.item__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.item__link {
  font-size: 24rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  opacity: 0.5;
}

.empty__text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-3);
}

.empty__btn {
  margin-top: 32rpx;
  padding: 14rpx 56rpx;
  border-radius: 36rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 28rpx;
}

.more {
  display: block;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

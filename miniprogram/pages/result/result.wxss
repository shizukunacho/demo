.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 100rpx;
  color: #FFFFFF;
}

.head__icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 56rpx;
  font-weight: 700;
}

.head__label {
  margin-top: 20rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.head__result {
  margin-top: 4rpx;
  font-size: 48rpx;
  font-weight: 600;
}

.head__time {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.overview {
  display: flex;
  align-items: center;
  margin-top: -64rpx;
  padding: 32rpx 0;
}

.overview__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview__value {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
}

.overview__unit {
  font-size: 26rpx;
  margin-left: 2rpx;
}

.overview__label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.overview__line {
  width: 1px;
  height: 64rpx;
  background: var(--line);
}

.prob {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.prob__name {
  width: 80rpx;
  font-size: 26rpx;
  color: var(--text);
}

.prob__track {
  flex: 1;
  height: 20rpx;
  border-radius: 10rpx;
  background: #F0F1F5;
  overflow: hidden;
}

.prob__fill {
  height: 100%;
  border-radius: 10rpx;
}

.prob__fill--normal { background: var(--normal); }
.prob__fill--benign { background: var(--benign); }
.prob__fill--malignant { background: var(--malignant); }

.prob__value {
  width: 110rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text-2);
}

.figs {
  display: flex;
}

.fig {
  flex: 1;
}

.fig:first-child {
  margin-right: 20rpx;
}

.fig__img {
  display: block;
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  background: #111111;
}

.fig__cap {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}

.text {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
}

.text--gap {
  margin-top: 12rpx;
  color: var(--text-2);
}

.advice {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
}

.advice__label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

.advice__text {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text);
}

.info {
  padding: 12rpx 28rpx;
}

.info__row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.info__k {
  color: var(--text-3);
}

.info__v {
  color: var(--text);
}

.statement {
  margin: 8rpx 32rpx 0;
}

.statement__title {
  display: block;
  font-size: 24rpx;
  color: var(--text-2);
}

.statement__text {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.footer__btn {
  flex: 1;
}

.footer__btn:first-child {
  margin-right: 24rpx !important;
}

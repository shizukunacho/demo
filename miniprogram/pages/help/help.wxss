.search-wrap {
  padding: 20rpx 24rpx;
  background: #FFFFFF;
}

.search {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #F5F6FA;
}

.search__input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
}

.search__ph {
  color: #999999;
}

.block-title {
  padding: 32rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.faq {
  margin: 0 24rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
}

.faq__item {
  border-bottom: 1px solid var(--line);
}

.faq__item:last-child {
  border-bottom: none;
}

.faq__q {
  display: flex;
  align-items: center;
  min-height: 100rpx;
}

.faq__q-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.faq__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #C8C8C8;
  border-bottom: 3rpx solid #C8C8C8;
  transform: rotate(45deg);
  margin: -6rpx 8rpx 0 16rpx;
  transition: transform 0.2s;
}

.faq__arrow--open {
  transform: rotate(-135deg);
  margin-top: 8rpx;
}

.faq__a {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-2);
}

.faq__none {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}

.group {
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

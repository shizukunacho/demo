<view class="page">
  <view class="list" wx:if="{{list.length}}">
    <view class="item" wx:for="{{list}}" wx:key="id" hover-class="cell-hover" bindtap="openArticle" data-id="{{item.id}}">
      <view class="item__main">
        <text class="item__title">{{item.title}}</text>
        <view class="item__meta">
          <text class="tag tag--blue">{{item.tag}}</text>
          <text class="item__date">{{item.date}}</text>
        </view>
      </view>
      <text class="item__remove" catchtap="removeItem" data-id="{{item.id}}">取消收藏</text>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty__star">☆</text>
    <text class="empty__text">还没有收藏文章</text>
    <text class="empty__sub">在文章详情页点击底部「收藏」即可添加</text>
    <view class="empty__btn" bindtap="goToKnowledge">去看看</view>
  </view>
</view>
